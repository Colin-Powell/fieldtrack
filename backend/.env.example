# -----------------------------------------------------------------------------
# FieldTrack Backend – Environment Configuration
# Copy this file to .env and fill in the values for your environment.
# NEVER commit the actual .env file to source control.
# -----------------------------------------------------------------------------

# -- App -----------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# -- Database ------------------------------------------------------------------
# PostgreSQL connection string (used by Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/fieldtrack_db?schema=public"

# -- Redis ---------------------------------------------------------------------
# Redis URL for session caching and BullMQ job queues
REDIS_URL="redis://localhost:6379"
# Optional Redis password (leave blank if not set)
REDIS_PASSWORD=""

# -- Authentication ------------------------------------------------------------
JWT_SECRET="your-very-long-random-jwt-secret-here"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="your-very-long-random-refresh-secret-here"
REFRESH_TOKEN_EXPIRES_IN="7d"

# -- Firebase ------------------------------------------------------------------
# Path to your Firebase service account JSON key file
FIREBASE_SERVICE_ACCOUNT_PATH="./firebase-service-account.json"
# Firebase project ID
FIREBASE_PROJECT_ID="your-firebase-project-id"
# Firebase Cloud Storage bucket name (e.g. my-project.appspot.com)
FIREBASE_STORAGE_BUCKET="your-firebase-project.appspot.com"

# -- Rate Limiting -------------------------------------------------------------
# Max requests per window per IP on the general API
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# -- Device Restrictions -------------------------------------------------------
# Maximum number of concurrent devices allowed per user
MAX_DEVICES_PER_USER=5

# -- File Uploads --------------------------------------------------------------
# Maximum file size in bytes for media uploads (default: 50MB)
MAX_UPLOAD_SIZE_BYTES=52428800

# -- Logging -------------------------------------------------------------------
# Log level: error | warn | info | http | verbose | debug | silly
LOG_LEVEL=info

# -- CORS ----------------------------------------------------------------------
# Comma-separated list of allowed origins
CORS_ORIGINS="http://localhost:3000,https://yourdomain.com"

# -- Developer / Admin ---------------------------------------------------------
# Password for the developer dashboard
DEVELOPER_PASSWORD="change-this-in-production"
